            orders.customer_id,
            orders.orders_id,
            orders.order_date,
            (
                select count(distinct orders_t2.orders_id)
                from orders orders_t2
                where orders_t2.customer_id = orders.customer_id
                and orders_t2.order_date between orders.order_date - interval '12 months' and orders.order_date
            ) as total_orders_past_12_months
        from orders
) limit 1000
