  create or replace view `thcanalyticsinsights`.`thcanalyticsinsights_dev_1`.`stg_thc_analytics__sales`
  OPTIONS()
  as with
    source as (
        select
            *
        from `thcanalyticsinsights`.`thcanalyticsinsights_dev_1`.`sales_recrutement`
    ),

    renamed as (
        select
            to_hex(md5(cast(coalesce(cast(order_id as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(customer_id as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(products_id as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(date_date as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(net_sales as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(qty as string), '_dbt_utils_surrogate_key_null_') as string))) as sales_id,
            order_id,
            date_date as sale_date,
            customer_id,
            products_id,
            ROUND(net_sales, 2) as sales_amount,
            qty as sale_product_quantity
        from source
    )
select * from renamed;


