14:31:12.027933 [debug]: Query executed on node unknown:

  
  with
    customers_orders as (
        select * from `thcanalyticsinsights`.`thcanalyticsinsights_dev_1`.`int_customers_orders`
    ),

    orders as (
        select * from `thcanalyticsinsights`.`thcanalyticsinsights_dev_1`.`stg_thc_analytics__orders`
    ),

    -- Count total orders for each customer within the 12 months prior to each order
    segmented as (
        select
            o1.customer_id,
            o1.orders_id,
            o1.order_date,
            count(distinct o2.orders_id) as total_orders_past_12_months
        from orders as o1
        left join orders as o2
            on o1.customer_id = o2.customer_id
            and cast(o2.order_date as date) between date_sub(cast(o1.order_date as date), interval 12 month)and cast(o1.order_date as date)
        group by
            o1.customer_id,
            o1.orders_id,
            o1.order_date
    ),

    customers_status as (
        select
            segmented.customer_id,
            segmented.orders_id,
            segmented.order_date,
            segmented.total_orders_past_12_months,
            customers_orders.total_orders,
            case
                when customers_orders.total_orders = 1 and segmented.total_orders_past_12_months = 1 then 'New'
                when customers_orders.total_orders > 1 and segmented.total_orders_past_12_months between 2 and 4 then 'Returning'
                when customers_orders.total_orders > 1 and segmented.total_orders_past_12_months > 4 then 'VIP'
                else 'Unknown'
            end as customer_status
        from segmented
        left join customers_orders
            on customers_orders.customer_id = segmented.customer_id
    )

select * from customers_status
  
  limit 1000

